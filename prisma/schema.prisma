// slowell — data model
// See .claude/plans/phase-1-data-model.md for the design rationale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth.js v5 adapter tables (passwordless variant) ──────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?

  // slowell-specific profile
  handle      String    @unique
  displayName String?
  bio         String?
  themePref   ThemePref @default(SYSTEM)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts        Account[]
  sessions        Session[]
  collectionItems CollectionItem[]

  @@index([handle])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum ThemePref {
  SYSTEM
  LIGHT
  DARK
}

// ─── Domain ────────────────────────────────────────────────────────────────

model Album {
  id             String         @id @default(cuid())
  title          String
  artist         String
  year           Int?
  metadataSource MetadataSource @default(MANUAL)
  externalId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pressings Pressing[]

  @@unique([metadataSource, externalId])
  @@index([artist])
  @@index([title])
}

model Pressing {
  id             String         @id @default(cuid())
  albumId        String
  album          Album          @relation(fields: [albumId], references: [id], onDelete: Cascade)
  format         Format
  label          String?
  country        String?
  year           Int?
  catalogNumber  String?
  variant        String?
  coverUrl       String?
  metadataSource MetadataSource @default(MANUAL)
  externalId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collectionItems CollectionItem[]

  @@unique([metadataSource, externalId])
  @@index([albumId])
}

model CollectionItem {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pressingId     String
  pressing       Pressing  @relation(fields: [pressingId], references: [id], onDelete: Restrict)
  notes          String?
  customCoverUrl String?
  acquiredAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([pressingId])
}

enum Format {
  CD
  VINYL
}

enum MetadataSource {
  DISCOGS
  MUSICBRAINZ
  MANUAL
}

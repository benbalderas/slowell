# Copy to .env (or .env.local) and fill in. .env is gitignored.

# Neon Postgres — get both from the Neon dashboard's Connection Details panel.
# The pooled string ends in `-pooler.<region>...`; the direct string drops `-pooler`.
DATABASE_URL=
DIRECT_URL=

# Auth.js (passwordless / magic link via Resend)
# Generate AUTH_SECRET with: openssl rand -base64 32
# AUTH_URL is the canonical app URL — http://localhost:3000 in dev, https://slowell.club in prod.
AUTH_SECRET=
AUTH_URL=
AUTH_EMAIL_FROM=

# Resend API key — generate at https://resend.com/api-keys, scoped to slowell.club
RESEND_API_KEY=
